---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { Layers, Sparkles } from 'lucide-astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['All', ...siteConfig.categories.map((c) => c.name)];
---

<BaseLayout
  title={`All Articles & Notes — ${siteConfig.name}`}
  description={siteConfig.description}
>
  <!-- Page Header -->
  <div class="mb-10 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 mb-2.5">
          <Layers class="w-3.5 h-3.5" />
          Personal Notes & Guides
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight">
          All Articles
        </h1>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2">
          Total published posts: <strong class="text-zinc-900 dark:text-zinc-100 font-mono font-semibold">{sortedPosts.length}</strong>
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-2">
        {categories.map((category) => (
          <a
            href={category === 'All' ? url('/blog') : url(`/categories/${category.toLowerCase()}`)}
            class:list={[
              'px-4 py-2 text-xs font-semibold rounded-full transition-all',
              category === 'All'
                ? 'bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 text-white shadow-md shadow-indigo-500/25'
                : 'liquid-pill text-zinc-700 dark:text-zinc-300 hover:text-indigo-600 dark:hover:text-indigo-300',
            ]}
          >
            {category}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Articles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {sortedPosts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
