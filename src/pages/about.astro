---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpeechBubble from '../components/mdx/SpeechBubble.astro';
import siteConfig from '../config/site';
import { Layers, Shield, Cpu, Zap, Sparkles, Github, Twitter, Linkedin, Mail, Code2, Rocket, Compass, Heart } from 'lucide-astro';

const aboutData = siteConfig.about;

const techArsenal = aboutData?.techArsenal || [
  { name: 'Astro 7', desc: 'Islands architecture, server islands, and zero-JS defaults', category: 'Framework' },
  { name: 'TypeScript', desc: 'Strict domain models, algebraic types, and nominal branding', category: 'Language' },
  { name: 'Tailwind CSS 4', desc: 'Liquid Glass design system, modern gradients & CSS tokens', category: 'Styling' },
  { name: 'Vite & Pagefind', desc: 'Instant hot-reloading and lightning-fast static indexing', category: 'Tooling' },
  { name: 'React / Preact', desc: 'Isolated reactive client components when state is required', category: 'UI Library' },
  { name: 'Edge Runtimes', desc: 'Distributed low-latency deployment at the CDN edge', category: 'Infra' },
];

const highlights = aboutData?.highlights || [
  {
    icon: '⚡',
    title: 'Speed & Zero-JS',
    desc: 'Shipping ultra-lightweight static HTML first, hydrating only when client interactivity is strictly required.',
  },
  {
    icon: '✨',
    title: 'Liquid Glass Design',
    desc: 'Crafting translucent, refractive spatial UI with specular highlights and GPU-accelerated blur effects.',
  },
  {
    icon: '🛡️',
    title: 'Type Safety & Domain Invariants',
    desc: 'Eliminating entire categories of runtime bugs using compiler-enforced discriminated unions and pure functions.',
  },
  {
    icon: '🚀',
    title: '60fps Micro-Interactions',
    desc: 'Building responsive spring physics, compositor animations, and tactile interactive feedback.',
  },
];

const philosophyTitle = aboutData?.philosophyTitle || 'My Engineering Philosophy';
const philosophyParagraphs = aboutData?.philosophyParagraphs || [
  'I started this blog as my personal digital garden—a place to document experiments, architectural patterns, and lessons learned while crafting modern web applications.',
  'I believe that a modern website should feel instantaneous, tactile, and visually delightful. In an era where web apps often ship megabytes of unnecessary JavaScript runtimes, I advocate for content-first static delivery with selective island hydration.',
];
const quote = aboutData?.quote || 'Every byte of JavaScript saved and every millisecond shaved off TTFB makes the web a faster, more accessible, and more joyful space for everyone.';
---

<BaseLayout
  title={`About Me — ${siteConfig.name}`}
  description={`Learn more about ${siteConfig.author.name}, engineering journey, tech stack, and digital garden.`}
>
  <!-- Page Header with Author Photo -->
  <div class="mb-10 p-8 sm:p-12 liquid-glass rounded-3xl shadow-xl relative overflow-hidden group">
    <!-- Ambient Internal Smooth Radial Glow (Zero clipping artifact) -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.2),rgba(6,182,212,0.1)_35%,transparent_65%)] pointer-events-none rounded-3xl"></div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center relative z-10">
      <div class="md:col-span-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 mb-3.5">
          <Sparkles class="w-3.5 h-3.5" />
          Developer Bio
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight mb-4">
          About Me
        </h1>
        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 font-normal leading-relaxed">
          Hey there! I'm <strong class="text-zinc-900 dark:text-white font-semibold">{siteConfig.author.name}</strong> — {siteConfig.author.bio}
        </p>
      </div>

      <div class="md:col-span-4 flex justify-center md:justify-end">
        <div class="relative group/avatar">
          <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 rounded-3xl blur-md opacity-40 group-hover/avatar:opacity-75 transition duration-500"></div>
          <img
            src={siteConfig.author.avatar}
            alt={siteConfig.author.name}
            class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-3xl object-cover border-2 border-white/40 dark:border-white/20 shadow-2xl"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Main Story Section -->
  <section class="my-10 liquid-glass rounded-3xl shadow-xl p-7 sm:p-10 overflow-hidden">
    <div class="flex items-center gap-2.5 border-b border-white/20 dark:border-white/10 pb-4 mb-6">
      <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-cyan-400 to-indigo-500"></span>
      <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50">
        {philosophyTitle}
      </h2>
    </div>

    <div class="prose prose-zinc dark:prose-invert max-w-none text-zinc-700 dark:text-zinc-300 space-y-4 leading-relaxed text-sm sm:text-base">
      {philosophyParagraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <div class="my-8">
      <SpeechBubble speaker={siteConfig.author.name} role={siteConfig.author.role} avatar="⚡" side="left">
        "{quote}"
      </SpeechBubble>
    </div>
  </section>

  <!-- Core Pillars -->
  <section class="my-12">
    <div class="flex items-center gap-2.5 border-b border-white/20 dark:border-white/10 pb-4 mb-8">
      <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500"></span>
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50">
        What I Focus On
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {highlights.map((item) => (
        <div class="p-7 liquid-glass-card rounded-3xl shadow-lg flex flex-col justify-between overflow-hidden">
          <div>
            <div class="w-12 h-12 rounded-full liquid-pill flex items-center justify-center text-2xl shadow-md mb-4">
              {item.icon}
            </div>

            <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50 mb-2">
              {item.title}
            </h3>

            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Technology Stack & Tools -->
  <section class="my-12 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl overflow-hidden">
    <div class="flex items-center justify-between border-b border-white/20 dark:border-white/10 pb-4 mb-6">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-amber-400 to-rose-500"></span>
        <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">
          My Daily Tech Arsenal
        </h2>
      </div>
      <span class="text-xs font-mono text-zinc-400">FAVORITE TOOLS</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {techArsenal.map((tech) => (
        <div class="p-5 rounded-2xl liquid-glass-card flex flex-col justify-between shadow-xs">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
                {tech.name}
              </span>
              <span class="px-2.5 py-0.5 rounded-full liquid-pill text-indigo-600 dark:text-indigo-300 text-[10px] font-mono font-semibold">
                {tech.category}
              </span>
            </div>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
              {tech.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Connect & Socials -->
  <section class="my-12 p-8 sm:p-10 liquid-glass rounded-3xl shadow-xl relative overflow-hidden group text-center sm:text-left">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-8 space-y-2">
        <h3 class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight">
          Let's Connect & Collaborate
        </h3>
        <p class="text-sm text-zinc-600 dark:text-zinc-300 max-w-xl leading-relaxed">
          Whether you want to discuss frontend architecture, share feedback on an article, or just say hi, feel free to reach out!
        </p>
      </div>

      <div class="md:col-span-4 flex flex-wrap justify-center md:justify-end gap-3">
        {siteConfig.author.social.github && (
          <a
            href={siteConfig.author.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-3 rounded-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:from-cyan-400 hover:via-indigo-500 hover:to-purple-500 text-white text-xs font-semibold shadow-lg shadow-indigo-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all"
          >
            <Github class="w-4 h-4" />
            <span>GitHub</span>
          </a>
        )}

        {siteConfig.author.social.twitter && (
          <a
            href={siteConfig.author.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-3 rounded-full liquid-pill hover:border-indigo-400/40 text-xs font-semibold text-zinc-800 dark:text-zinc-200 hover:scale-[1.02] transition-all"
          >
            <Twitter class="w-4 h-4" />
            <span>Twitter / X</span>
          </a>
        )}

        {siteConfig.author.social.linkedin && (
          <a
            href={siteConfig.author.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-3 rounded-full liquid-pill hover:border-indigo-400/40 text-xs font-semibold text-zinc-800 dark:text-zinc-200 hover:scale-[1.02] transition-all"
          >
            <Linkedin class="w-4 h-4" />
            <span>LinkedIn</span>
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
