---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config/site';
import { Home, Compass, Search, ArrowLeft, Terminal, Sparkles } from 'lucide-astro';
const notFound = siteConfig.notFound || {
  badge: 'HTTP_STATUS // 404_NOT_FOUND',
  title: 'Page Lost in the Stream',
  description:
    "The route, article, or resource you were looking for doesn't exist, has been moved, or is currently being rewritten.",
  homeButtonText: 'Return Home',
  browseButtonText: 'Browse Articles',
};
---

<BaseLayout
  title={`404: Page Not Found — ${siteConfig.name}`}
  description="The requested page or publication could not be found."
>
  <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 flex flex-col items-center justify-center text-center">
    <!-- Main Liquid Glass 404 Hero Container -->
    <div class="w-full max-w-2xl liquid-glass rounded-3xl p-8 sm:p-12 relative overflow-hidden shadow-2xl border border-white/20 dark:border-white/10">
      <!-- Ambient Backlight Glow -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-72 h-72 bg-gradient-to-tr from-cyan-500/25 via-indigo-500/30 to-purple-500/25 blur-3xl pointer-events-none rounded-full" aria-hidden="true"></div>

      <!-- Top Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full liquid-pill text-indigo-600 dark:text-indigo-400 text-xs font-mono font-semibold mb-6 border border-indigo-400/20">
        <Terminal class="w-3.5 h-3.5" />
        <span>{notFound.badge}</span>
      </div>

      <!-- Giant Prismatic 404 -->
      <div class="relative mb-4 select-none">
        <h1 class="text-8xl sm:text-9xl font-extrabold tracking-tighter text-prismatic">
          404
        </h1>
        <div class="absolute inset-0 text-8xl sm:text-9xl font-extrabold tracking-tighter opacity-10 blur-xl text-indigo-500 select-none pointer-events-none" aria-hidden="true">
          404
        </div>
      </div>

      <!-- Heading -->
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 tracking-tight mb-3">
        {notFound.title}
      </h2>

      <!-- Description -->
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-md mx-auto leading-relaxed mb-8">
        {notFound.description}
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3.5 mb-10">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 text-white font-semibold text-xs sm:text-sm shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
        >
          <Home class="w-4 h-4" />
          <span>{notFound.homeButtonText}</span>
        </a>

        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full liquid-pill text-zinc-800 dark:text-zinc-200 font-semibold text-xs sm:text-sm hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400/40 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
        >
          <Compass class="w-4 h-4" />
          <span>{notFound.browseButtonText}</span>
        </a>

        <button
          id="trigger-search-404"
          type="button"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full liquid-pill text-zinc-700 dark:text-zinc-300 font-semibold text-xs sm:text-sm hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400/40 transition-all cursor-pointer"
        >
          <Search class="w-4 h-4" />
          <span>Search (⌘K)</span>
        </button>
      </div>

      <!-- Topic Shortcuts -->
      <div class="pt-6 border-t border-white/20 dark:border-white/10">
        <div class="text-xs font-mono text-zinc-400 mb-3 flex items-center justify-center gap-1.5">
          <Sparkles class="w-3.5 h-3.5 text-indigo-400" />
          <span>POPULAR EXPLORATION TOPICS</span>
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          {siteConfig.categories.map((cat) => (
            <a
              href={`/categories/${cat.name.toLowerCase()}`}
              class="px-3 py-1 rounded-full text-xs font-medium liquid-pill text-zinc-700 dark:text-zinc-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-400/40 transition-all"
            >
              #{cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>

  <script>
    document.getElementById('trigger-search-404')?.addEventListener('click', () => {
      const openBtn = document.getElementById('search-open-btn');
      openBtn?.click();
    });
  </script>
</BaseLayout>
