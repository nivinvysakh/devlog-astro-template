---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { ArrowLeft } from 'lucide-astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const configuredCategories = siteConfig.categories.map((c) => c.name.toLowerCase());
  const postCategories = allPosts.map((p) => p.data.category.toLowerCase());
  const categories = [...new Set([...configuredCategories, ...postCategories])];

  return categories.map((cat) => {
    const filteredPosts = allPosts.filter(
      (p) => p.data.category.toLowerCase() === cat.toLowerCase()
    ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: cat },
      props: { category: cat, posts: filteredPosts },
    };
  });
}

const { category, posts } = Astro.props;
const categoryTitle = category.charAt(0).toUpperCase() + category.slice(1);
---

<BaseLayout
  title={`${categoryTitle} Articles — ${siteConfig.name}`}
  description={`Browse technical articles and architecture patterns in ${categoryTitle}`}
>
  <div class="mb-6">
    <a
      href={url('/categories')}
      class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-zinc-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>All Categories</span>
    </a>
  </div>

  <div class="mb-10 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl">
    <div class="flex items-center justify-between">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 mb-2.5">
          Category Collection
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight">
          {categoryTitle}
        </h1>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2">
          {posts.length} {posts.length === 1 ? 'article' : 'articles'} published in this domain
        </p>
      </div>
    </div>
  </div>

  {posts.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  ) : (
    <div class="p-12 text-center liquid-glass rounded-3xl">
      <p class="text-sm text-zinc-500">No articles currently published in this section.</p>
    </div>
  )}
</BaseLayout>
