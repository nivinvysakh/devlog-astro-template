---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../config/site';
import { getCollection } from 'astro:content';
import { ArrowRight, Layers } from 'lucide-astro';

const allPosts = await getCollection('blog');

const categories = siteConfig.categories;

const categoryList = categories.map((cat) => ({
  ...cat,
  posts: allPosts.filter((p) => p.data.category.toLowerCase() === cat.name.toLowerCase()),
}));
---

<BaseLayout
  title={`Explore Categories — ${siteConfig.name}`}
  description="Browse technical articles and architecture patterns organized by topic."
>
  <div class="mb-10 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 mb-2.5">
      <Layers class="w-3.5 h-3.5" />
      Topic Domains
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight">
      Browse by Category
    </h1>
    <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2">
      Select a domain to explore specialized engineering guides and architectural patterns.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {categoryList.map((cat) => (
      <a
        href={`/categories/${cat.name.toLowerCase()}`}
        class="group p-7 rounded-3xl liquid-glass-card shadow-lg hover:scale-[1.02] transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between border-b border-white/20 dark:border-white/10 pb-4 mb-4">
            <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              {cat.name}
            </h2>
            <span class="w-8 h-8 rounded-full liquid-pill flex items-center justify-center font-mono text-xs font-bold text-indigo-600 dark:text-indigo-300">
              {cat.posts.length}
            </span>
          </div>

          <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-6 leading-relaxed">
            {cat.desc}
          </p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-white/15 dark:border-white/10 text-xs font-semibold text-indigo-600 dark:text-indigo-400">
          <span>Explore Articles</span>
          <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
