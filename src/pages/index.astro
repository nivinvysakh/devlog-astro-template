---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMagazineCover from '../components/ui/HeroMagazineCover.astro';
import PostCard from '../components/ui/PostCard.astro';
import TagBadge from '../components/ui/TagBadge.astro';
import siteConfig from '../config/site';
import { url } from '../utils/paths';
import { getCollection } from 'astro:content';
import { ArrowRight, Sparkles, Layers, Zap, Code, Terminal, Github } from 'lucide-astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = sortedPosts[0];
const recentPosts = sortedPosts.slice(1);

const categories = siteConfig.categories.map((cat) => ({
  name: cat.name,
  desc: cat.desc,
  count: sortedPosts.filter((p) => p.data.category.toLowerCase() === cat.name.toLowerCase()).length,
}));

const allTags = [...new Set(sortedPosts.flatMap((p) => p.data.tags || []))];

const ui = siteConfig.ui || {
  latestPostsBadge: 'Recent Writing',
  latestPostsTitle: 'Latest Notes & Deep Dives',
  categoriesTitle: 'Browse by Topic',
  tagsTitle: 'Popular Tags',
};
---

<BaseLayout>
  <!-- Personal Intro Hero Banner -->
  <section class="mb-8 sm:mb-12 p-6 sm:p-10 lg:p-12 liquid-glass rounded-3xl shadow-xl relative overflow-hidden group">
    <!-- Ambient Internal Smooth Radial Glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.2),rgba(6,182,212,0.1)_35%,transparent_65%)] pointer-events-none rounded-3xl"></div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 items-center relative z-10">
      <div class="md:col-span-8 lg:col-span-9 order-2 md:order-1">
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-300 border border-indigo-400/20 mb-4 sm:mb-5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{siteConfig.hero.badge}</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-2xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-50 tracking-tight leading-[1.15] mb-4 sm:mb-5">
          {siteConfig.hero.greeting} <span class="inline-block animate-bounce">👋</span>
        </h1>

        <p class="text-sm sm:text-lg text-zinc-300 font-normal leading-relaxed mb-6 sm:mb-8 max-w-2xl">
          {siteConfig.hero.tagline}
        </p>

        <!-- Quick Action Buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={url(siteConfig.hero.primaryButton.href)}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:from-cyan-400 hover:via-indigo-500 hover:to-purple-500 text-white text-xs sm:text-sm font-semibold shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all w-full sm:w-auto text-center"
          >
            <span>{siteConfig.hero.primaryButton.text}</span>
            <ArrowRight class="w-4 h-4" />
          </a>

          <a
            href={url(siteConfig.hero.secondaryButton.href)}
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full liquid-pill hover:border-indigo-400/40 text-zinc-200 text-xs sm:text-sm font-semibold hover:scale-[1.02] transition-all w-full sm:w-auto text-center"
          >
            <span>{siteConfig.hero.secondaryButton.text}</span>
          </a>

          {siteConfig.author.social.github && (
            <a
              href={siteConfig.author.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-full liquid-pill hover:border-indigo-400/40 text-zinc-400 hover:text-indigo-300 text-xs sm:text-sm font-semibold transition-all w-full sm:w-auto text-center"
              title="GitHub"
            >
              <Github class="w-4 h-4" />
              <span>GitHub</span>
            </a>
          )}
        </div>
      </div>

      <!-- Author Portrait Avatar -->
      <div class="flex md:col-span-4 lg:col-span-3 justify-start md:justify-end order-1 md:order-2">
        <div class="relative group/avatar">
          <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 rounded-2xl sm:rounded-3xl blur-md opacity-35 group-hover/avatar:opacity-70 transition duration-500"></div>
          <img
            src={url(siteConfig.author.avatar)}
            alt={siteConfig.author.name}
            class="relative w-20 h-20 sm:w-36 sm:h-36 lg:w-44 lg:h-44 rounded-2xl sm:rounded-3xl object-cover border-2 border-white/20 shadow-2xl transition-transform duration-500 group-hover/avatar:scale-105"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Post Spotlight Section -->
  {featuredPost && <HeroMagazineCover post={featuredPost} />}

  <!-- Section Header: Latest Articles -->
  <section class="mt-14 mb-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-white/20 dark:border-white/10 pb-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 mb-2">
          <Sparkles class="w-3.5 h-3.5" />
          {ui.latestPostsBadge}
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight">
          {ui.latestPostsTitle}
        </h2>
      </div>

      <!-- View All Link -->
      <a
        href={url('/blog')}
        class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 transition-colors"
      >
        <span>View All Articles ({allPosts.length})</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>

  <!-- Categories & Tags Section -->
  <section class="my-16 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Categories (7 cols) -->
    <div class="lg:col-span-7 liquid-glass rounded-3xl p-7 sm:p-8 shadow-lg">
      <div class="flex items-center justify-between border-b border-white/20 dark:border-white/10 pb-4 mb-6">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-cyan-400 to-indigo-500"></span>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">
            {ui.categoriesTitle}
          </h3>
        </div>
        <span class="text-xs font-mono text-zinc-400">CATEGORIES</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {categories.map((cat) => (
          <a
            href={url(`/categories/${cat.name.toLowerCase()}`)}
            class="group p-5 rounded-2xl liquid-glass-card hover:scale-[1.02] flex flex-col justify-between transition-all"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-base font-bold text-zinc-900 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                {cat.name}
              </span>
              <span class="w-7 h-7 rounded-full liquid-pill flex items-center justify-center font-mono text-xs font-bold text-indigo-600 dark:text-indigo-300">
                {cat.count}
              </span>
            </div>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
              {cat.desc}
            </p>
          </a>
        ))}
      </div>
    </div>

    <!-- Tags Pill Cloud (5 cols) -->
    <div class="lg:col-span-5 liquid-glass rounded-3xl p-7 sm:p-8 shadow-lg flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between border-b border-white/20 dark:border-white/10 pb-4 mb-6">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500"></span>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">
              {ui.tagsTitle}
            </h3>
          </div>
          <span class="font-mono text-xs text-zinc-400">#TAGS</span>
        </div>

        <div class="flex flex-wrap gap-2">
          {allTags.map((tag) => (
            <TagBadge tag={tag} size="sm" />
          ))}
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-white/15 dark:border-white/10 flex justify-between items-center text-xs text-zinc-400 font-mono">
        <span>TOTAL TOPICS: {allTags.length}</span>
        <span class="text-indigo-600 dark:text-indigo-400 font-semibold">Digital Garden</span>
      </div>
    </div>
  </section>
</BaseLayout>

