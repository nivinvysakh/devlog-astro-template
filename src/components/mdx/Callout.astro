---
interface Props {
  type?: 'tip' | 'warning' | 'secret' | 'technique';
  title?: string;
  badge?: string;
}

const {
  type = 'tip',
  title,
  badge,
} = Astro.props;

const styles = {
  tip: {
    border: 'border-l-4 border-l-cyan-400',
    badgeBg: 'bg-cyan-500/15 text-cyan-700 dark:text-cyan-300 border-cyan-500/25',
    defaultBadge: 'PRO TIP',
    icon: '💡',
  },
  warning: {
    border: 'border-l-4 border-l-rose-500',
    badgeBg: 'bg-rose-500/15 text-rose-700 dark:text-rose-300 border-rose-500/25',
    defaultBadge: 'WARNING',
    icon: '⚠️',
  },
  secret: {
    border: 'border-l-4 border-l-purple-500',
    badgeBg: 'bg-purple-500/15 text-purple-700 dark:text-purple-300 border-purple-500/25',
    defaultBadge: 'ARCHITECTURE NOTE',
    icon: '📜',
  },
  technique: {
    border: 'border-l-4 border-l-indigo-500',
    badgeBg: 'bg-indigo-500/15 text-indigo-700 dark:text-indigo-300 border-indigo-500/25',
    defaultBadge: 'CORE TECHNIQUE',
    icon: '⚡',
  },
};

const current = styles[type];
---

<div
  class:list={[
    'my-6 p-5 sm:p-6 rounded-3xl liquid-glass shadow-lg transition-all overflow-hidden',
    current.border,
  ]}
>
  <div class="flex items-center gap-3 mb-3">
    <span class="text-lg select-none">{current.icon}</span>
    <span
      class:list={[
        'text-xs font-bold px-2.5 py-0.5 rounded-full border shadow-2xs tracking-wider uppercase',
        current.badgeBg,
      ]}
    >
      {badge || current.defaultBadge}
    </span>
    {title && (
      <span class="text-sm sm:text-base font-bold text-zinc-900 dark:text-zinc-50">
        {title}
      </span>
    )}
  </div>
  <div class="prose prose-sm dark:prose-invert max-w-none text-zinc-700 dark:text-zinc-300 leading-relaxed">
    <slot />
  </div>
</div>
