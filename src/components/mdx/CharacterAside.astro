---
interface Props {
  name: string;
  role?: string;
  avatar?: string;
}

const {
  name = 'Architecture Note',
  role = 'Lead Engineer',
  avatar = '⚡',
} = Astro.props;
---

<aside class="my-6 p-6 rounded-3xl liquid-glass shadow-lg flex flex-col sm:flex-row items-start gap-4 overflow-hidden">
  <div class="flex sm:flex-col items-center gap-2.5 sm:gap-2 shrink-0">
    <div class="w-12 h-12 rounded-full liquid-pill flex items-center justify-center text-2xl shadow-md">
      {avatar.startsWith('http') || avatar.startsWith('/') ? (
        <img src={avatar} alt={name} class="w-full h-full object-cover rounded-full" />
      ) : (
        <span>{avatar}</span>
      )}
    </div>
    <div class="text-left sm:text-center">
      <div class="font-bold text-xs text-zinc-900 dark:text-zinc-100">{name}</div>
      <div class="text-[10px] font-mono uppercase text-indigo-600 dark:text-indigo-400 font-semibold">{role}</div>
    </div>
  </div>

  <div class="flex-1 text-sm text-zinc-700 dark:text-zinc-300 relative">
    <div class="prose prose-sm dark:prose-invert max-w-none leading-relaxed">
      <slot />
    </div>
  </div>
</aside>
