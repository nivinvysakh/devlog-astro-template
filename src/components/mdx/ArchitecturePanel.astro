---
interface Props {
  columns?: 1 | 2 | 3;
  title?: string;
  caption?: string;
  badge?: string;
}

const {
  columns = 2,
  title = 'Architecture Matrix',
  caption,
  badge = 'ARCHITECTURE PANEL',
} = Astro.props;

const gridCols = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-3',
};
---

<div
  class="my-8 p-6 sm:p-7 rounded-3xl liquid-glass shadow-xl overflow-hidden"
>
  {title && (
    <div class="flex items-center justify-between border-b border-white/20 dark:border-white/10 pb-3 mb-6">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-cyan-400 to-indigo-500"></span>
        <h4 class="text-base font-bold text-zinc-900 dark:text-zinc-50 m-0">
          {title}
        </h4>
      </div>
      <span class="font-mono text-[11px] text-zinc-400">// {badge}</span>
    </div>
  )}

  <div class:list={['grid gap-4 sm:gap-6 items-stretch', gridCols[columns]]}>
    <slot />
  </div>

  {caption && (
    <div class="mt-5 pt-3.5 border-t border-white/15 dark:border-white/10 text-xs text-zinc-400 text-center font-mono">
      {caption}
    </div>
  )}
</div>
