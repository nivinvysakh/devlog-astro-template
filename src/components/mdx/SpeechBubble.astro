---
import { url } from '../../utils/paths';

interface Props {
  speaker?: string;
  role?: string;
  avatar?: string;
  side?: 'left' | 'right';
  variant?: 'normal' | 'shout' | 'thought' | 'insight';
}

const {
  speaker = 'Alex Rivera',
  role,
  avatar = '⚡',
  side = 'left',
  variant = 'normal',
} = Astro.props;

const isRight = side === 'right';
---

<div class:list={['my-6 flex gap-3 sm:gap-4 items-start', isRight ? 'flex-row-reverse' : 'flex-row']}>
  <!-- Avatar / Speaker portrait -->
  <div class="flex flex-col items-center shrink-0 w-16 text-center">
    <div
      class="w-12 h-12 rounded-full liquid-pill flex items-center justify-center text-xl shadow-md overflow-hidden"
    >
      {avatar.startsWith('http') || avatar.startsWith('/') ? (
        <img src={url(avatar)} alt={speaker} class="w-full h-full object-cover" />
      ) : (
        <span>{avatar}</span>
      )}
    </div>
    <span class="mt-1.5 text-xs font-bold text-zinc-900 dark:text-zinc-100 leading-tight break-words w-full">
      {speaker}
    </span>
  </div>

  <!-- Liquid Glass Capsule Bubble -->
  <div class:list={['relative max-w-[85%] sm:max-w-[80%]', isRight ? 'text-right' : 'text-left']}>
    <div
      class:list={[
        'p-5 text-sm font-normal rounded-3xl liquid-glass shadow-md transition-all overflow-hidden',
        variant === 'shout'
          ? 'border-indigo-400/40 bg-indigo-500/10 dark:bg-indigo-500/15'
          : variant === 'thought'
          ? 'border-dashed border-white/30 italic bg-white/30 dark:bg-white/5'
          : '',
      ]}
    >
      {role && (
        <div class="mb-1.5 text-[11px] font-mono tracking-wider uppercase text-indigo-600 dark:text-indigo-400 font-bold">
          // {role}
        </div>
      )}
      <div class="prose prose-sm dark:prose-invert max-w-none text-zinc-700 dark:text-zinc-200 leading-relaxed">
        <slot />
      </div>
    </div>
  </div>
</div>

