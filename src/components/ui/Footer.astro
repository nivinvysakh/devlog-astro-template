---
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { Rss, Github, Twitter, Sparkles, Heart } from 'lucide-astro';

const newsletter = siteConfig.newsletter || {
  badge: 'Personal Dev Notes',
  title: 'Follow My Engineering Journey & Experiments',
  description:
    'Occasional writeups on frontend architecture, liquid glass UI craft, Astro experiments, and lessons learned building software.',
  placeholder: 'you@domain.com',
  buttonText: 'Get Updates',
  successMessage: 'Thanks for subscribing to my dev notes!',
};
const brandDescription = siteConfig.footer.brandDescription || siteConfig.description;
---

<footer class="mt-20 border-t border-white/20 dark:border-white/10 relative overflow-hidden transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Newsletter Subscription Liquid Glass Card -->
    <div class="liquid-glass rounded-3xl p-7 sm:p-10 mb-12 shadow-xl relative overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 dark:border-indigo-400/20 mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
            {newsletter.badge}
          </div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-2 tracking-tight">
            {newsletter.title}
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            {newsletter.description}
          </p>
        </div>

        <div class="lg:col-span-5">
          <form class="flex flex-col sm:flex-row gap-2.5" onsubmit={`event.preventDefault(); alert(${JSON.stringify(newsletter.successMessage || 'Thanks for subscribing!')});`}>
            <input
              type="email"
              placeholder={newsletter.placeholder || 'you@domain.com'}
              required
              class="flex-1 px-4 py-3 text-sm rounded-full liquid-pill text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-xs"
            />
            <button
              type="submit"
              class="px-6 py-3 rounded-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:from-cyan-400 hover:via-indigo-500 hover:to-purple-500 text-white text-sm font-semibold shadow-lg shadow-indigo-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer shrink-0"
            >
              {newsletter.buttonText}
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-white/15 dark:border-white/10">
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-2 space-y-3.5">
        <div class="flex items-center gap-2.5">
          <div class="flex items-center justify-center w-7 h-7 rounded-full bg-gradient-to-tr from-cyan-400 to-indigo-600 text-white text-xs font-bold uppercase">
            {siteConfig.logoLetter || siteConfig.name.charAt(0)}
          </div>
          <span class="font-extrabold text-base text-zinc-50">
            {siteConfig.name.includes('.') ? (
              <>
                {siteConfig.name.split('.')[0]}
                <span class="text-prismatic">.{siteConfig.name.split('.').slice(1).join('.')}</span>
              </>
            ) : (
              siteConfig.name
            )}
          </span>
        </div>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 max-w-sm leading-relaxed">
          {brandDescription}
        </p>
        <div class="flex items-center gap-2 pt-1">
          {siteConfig.author.social.github && (
            <a
              href={siteConfig.author.social.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="p-2.5 rounded-full liquid-pill text-zinc-600 dark:text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-300 hover:scale-105 transition-all"
            >
              <Github class="w-4 h-4" />
            </a>
          )}
          {siteConfig.author.social.twitter && (
            <a
              href={siteConfig.author.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Twitter / X"
              class="p-2.5 rounded-full liquid-pill text-zinc-600 dark:text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-300 hover:scale-105 transition-all"
            >
              <Twitter class="w-4 h-4" />
            </a>
          )}
          <a
            href={url('/rss.xml')}
            aria-label="RSS Feed"
            class="p-2.5 rounded-full liquid-pill text-zinc-600 dark:text-zinc-400 hover:text-amber-500 hover:scale-105 transition-all"
          >
            <Rss class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3.5">
          Navigation
        </h4>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          {siteConfig.navLinks.map((link) => (
            <li><a href={url(link.href)} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">{link.text}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Topics -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3.5">
          Topics
        </h4>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          {siteConfig.categories.map((cat) => (
            <li><a href={url(`/categories/${cat.name.toLowerCase()}`)} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">{cat.name}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 text-xs text-zinc-500 dark:text-zinc-400 font-mono">
      <span>{siteConfig.name} // Personal Engineering Garden</span>
      <span>© {new Date().getFullYear()} {siteConfig.footer.copyright}. {siteConfig.footer.tagline}</span>
    </div>
  </div>
</footer>

