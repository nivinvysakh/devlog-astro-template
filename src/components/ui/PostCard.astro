---
import TagBadge from './TagBadge.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { ArrowUpRight, Calendar, User } from 'lucide-astro';

interface Props {
  post: any;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const data = post.data;
const slug = post.id.replace(/\.(md|mdx)$/, '');
const authorName = siteConfig.author.name;
const authorAvatar = siteConfig.author.avatar;
const postUrl = url(`/blog/${slug}`);
---

<article class="group relative flex flex-col justify-between liquid-glass-card rounded-3xl p-6 sm:p-7 shadow-md overflow-hidden">
  
  <div>
    <!-- Optional Hero Image Thumbnail Preview -->
    {data.heroImage && (
      <div class="mb-4 rounded-2xl overflow-hidden aspect-[16/9] relative border border-white/20 dark:border-white/10 shadow-xs">
        <img
          src={url(data.heroImage)}
          alt={data.heroImageAlt || data.title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/30 via-transparent to-transparent pointer-events-none"></div>
      </div>
    )}

    <!-- Top Pill Meta -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 dark:border-indigo-400/20">
        {data.category}
      </span>
      <span class="text-xs text-zinc-400 font-mono">
        {new Date(data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
      </span>
    </div>

    <!-- Main Title -->
    <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-50 tracking-tight leading-snug group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-3">
      <a href={postUrl} class="focus:outline-none">
        <span class="absolute inset-0 z-0"></span>
        {data.title}
      </a>
    </h3>

    <!-- Excerpt -->
    <p class="text-sm text-zinc-600 dark:text-zinc-300 font-normal line-clamp-2 mb-6 leading-relaxed">
      {data.description}
    </p>
  </div>

  <!-- Tags & Footer Meta -->
  <div class="pt-4 border-t border-white/20 dark:border-white/10 relative z-10">
    <div class="flex flex-wrap gap-1.5 mb-4">
      {data.tags?.slice(0, 2).map((tag: string) => (
        <TagBadge tag={tag} size="sm" />
      ))}
    </div>

    <div class="flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400 pt-1">
      <div class="flex items-center gap-2 font-medium text-zinc-700 dark:text-zinc-300">
        {authorAvatar && (authorAvatar.startsWith('/') || authorAvatar.startsWith('http')) ? (
          <img
            src={url(authorAvatar)}
            alt={authorName}
            class="w-5 h-5 rounded-full object-cover border border-white/20 dark:border-white/10 shrink-0"
          />
        ) : (
          <User class="w-3.5 h-3.5 text-indigo-500" />
        )}
        <span>{authorName}</span>
      </div>
      <div class="flex items-center gap-1 text-indigo-600 dark:text-indigo-400 font-semibold group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">
        <span>Read</span>
        <ArrowUpRight class="w-3.5 h-3.5" />
      </div>
    </div>
  </div>
</article>
