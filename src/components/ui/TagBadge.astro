---
import { url } from '../../utils/paths';

interface Props {
  tag: string;
  size?: 'sm' | 'md';
  active?: boolean;
}

const { tag, size = 'sm', active = false } = Astro.props;

const sizeClass = size === 'sm' ? 'text-xs px-3 py-1' : 'text-sm px-4 py-1.5';
---

<a
  href={url(`/tags/${encodeURIComponent(tag.toLowerCase())}`)}
  class:list={[
    'inline-flex items-center gap-1.5 font-medium rounded-full transition-all duration-200',
    sizeClass,
    active
      ? 'bg-indigo-600 text-white border border-indigo-500 shadow-md shadow-indigo-500/25'
      : 'liquid-pill text-zinc-700 dark:text-zinc-300 hover:text-indigo-600 dark:hover:text-indigo-300 hover:border-indigo-400/40 hover:shadow-sm hover:scale-[1.02]',
  ]}
>
  <span class="text-indigo-500 dark:text-indigo-400 text-xs font-mono font-semibold">#</span>
  <span>{tag}</span>
</a>
