---
import TagBadge from './TagBadge.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { ArrowRight, Calendar, User, Clock, Sparkles } from 'lucide-astro';

interface Props {
  post: any;
}

const { post } = Astro.props;
const data = post.data;
const slug = post.id.replace(/\.(md|mdx)$/, '');
const authorName = siteConfig.author.name;
const authorAvatar = siteConfig.author.avatar;
const postUrl = url(`/blog/${slug}`);
---

<section class="relative my-4 sm:my-10">
  <div class="relative liquid-glass rounded-3xl p-5 sm:p-8 lg:p-12 shadow-xl overflow-hidden group">
    
    <!-- Ambient Internal Smooth Radial Glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.2),rgba(6,182,212,0.1)_35%,transparent_65%)] pointer-events-none rounded-3xl"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center relative z-10">
      <div class={data.heroImage ? 'lg:col-span-7' : 'lg:col-span-12'}>
        <!-- Top Pill Meta -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-4 sm:mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-cyan-500/15 to-indigo-500/15 text-indigo-300 border border-indigo-400/25 shadow-xs">
            <Sparkles class="w-3.5 h-3.5 text-indigo-400" />
            Featured Article
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold liquid-pill text-zinc-300">
            {data.category}
          </span>
          {data.issueNumber && (
            <span class="text-xs text-zinc-400 font-mono">
              {data.issueNumber}
            </span>
          )}
        </div>

        <!-- Main Title Headline -->
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-50 tracking-tight leading-[1.2] sm:leading-[1.15] mb-3 sm:mb-5">
          <a href={postUrl} class="hover:text-prismatic transition-colors">
            {data.title}
          </a>
        </h1>

        <!-- Description -->
        <p class="text-sm sm:text-lg text-zinc-300 font-normal leading-relaxed mb-6 sm:mb-8 max-w-2xl">
          {data.description}
        </p>

        <!-- Metadata Bar & Action -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 sm:gap-6 pt-5 sm:pt-6 border-t border-white/10">
          <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs text-zinc-400">
            <div class="flex items-center gap-2 font-medium text-zinc-200">
              {authorAvatar && (authorAvatar.startsWith('/') || authorAvatar.startsWith('http')) ? (
                <img
                  src={url(authorAvatar)}
                  alt={authorName}
                  class="w-6 h-6 rounded-full object-cover border border-white/10 shrink-0"
                />
              ) : (
                <User class="w-3.5 h-3.5 text-indigo-500" />
              )}
              <span>{authorName}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <Calendar class="w-3.5 h-3.5 text-zinc-400" />
              <span>{new Date(data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
          </div>

          <a
            href={postUrl}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:from-cyan-400 hover:via-indigo-500 hover:to-purple-500 text-white text-sm font-semibold shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all w-full sm:w-auto text-center"
          >
            <span>Read Article</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>

      {data.heroImage && (
        <div class="lg:col-span-5 flex items-center justify-center self-center lg:-translate-y-6">
          <a
            href={postUrl}
            class="block w-full rounded-2xl overflow-hidden border border-white/25 dark:border-white/10 shadow-xl group/img relative"
          >
            <img
              src={url(data.heroImage)}
              alt={data.heroImageAlt || data.title}
              class="w-full h-64 sm:h-76 lg:h-[310px] object-cover object-center transition-transform duration-700 ease-out group-hover/img:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/35 via-transparent to-transparent pointer-events-none"></div>
          </a>
        </div>
      )}
    </div>
  </div>
</section>
