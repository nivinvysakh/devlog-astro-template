---
import SearchModal from './SearchModal.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { Menu, X, Rss, BookOpen, Tag, Compass, User, Github } from 'lucide-astro';

const navIcons: Record<string, any> = {
  Articles: BookOpen,
  Categories: Compass,
  Tags: Tag,
  'About Me': User,
};

const navItems = siteConfig.navLinks.map((link) => ({
  label: link.text,
  href: url(link.href),
  icon: navIcons[link.text] || Compass,
}));
---

<header class="sticky top-3 sm:top-4 z-50 max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 w-full transition-all">
  <div class="liquid-glass rounded-full px-3.5 sm:px-6 py-2 sm:py-2.5 flex items-center justify-between shadow-lg">
    
    <!-- Brand Mark -->
    <a href={url('/')} class="flex items-center gap-2 sm:gap-2.5 group">
      <div class="flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-gradient-to-tr from-cyan-400 via-indigo-500 to-purple-600 text-white shadow-md shadow-indigo-500/25 group-hover:scale-105 transition-transform font-bold text-xs uppercase">
        {siteConfig.logoLetter || siteConfig.name.charAt(0)}
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-extrabold text-sm sm:text-lg tracking-tight text-zinc-50 group-hover:text-indigo-400 transition-colors">
          {siteConfig.name.includes('.') ? (
            <>
              {siteConfig.name.split('.')[0]}
              <span class="text-prismatic">.{siteConfig.name.split('.').slice(1).join('.')}</span>
            </>
          ) : (
            siteConfig.name
          )}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 bg-white/5 p-1 rounded-full border border-white/10">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-4 py-1.5 rounded-full text-xs font-semibold text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right Action Tools -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <SearchModal />

      <a
        href={siteConfig.author.social.github || 'https://github.com'}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="hidden sm:flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full liquid-pill text-zinc-300 hover:text-indigo-300 hover:scale-105 transition-all shadow-xs"
        title="GitHub"
      >
        <Github class="w-4 h-4" />
      </a>

      <a
        href={url('/rss.xml')}
        aria-label="RSS Feed"
        class="hidden sm:flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full liquid-pill text-zinc-300 hover:text-amber-400 hover:scale-105 transition-all shadow-xs"
        title="Subscribe to RSS"
      >
        <Rss class="w-4 h-4" />
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle mobile menu"
        class="md:hidden flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-full liquid-pill text-zinc-200 hover:bg-white/15 transition-all cursor-pointer"
      >
        <Menu class="w-4 h-4 sm:w-5 sm:h-5" id="menu-icon-open" />
        <X class="w-4 h-4 sm:w-5 sm:h-5 hidden" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden mt-2 liquid-glass rounded-3xl p-3 sm:p-4 shadow-2xl border border-white/10 transition-all"
  >
    <div class="flex flex-col gap-1">
      {navItems.map((item) => {
        const IconComponent = item.icon;
        return (
          <a
            href={item.href}
            class="mobile-nav-link flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-semibold text-zinc-200 hover:text-white hover:bg-white/10 active:scale-[0.99] transition-all"
          >
            <IconComponent class="w-4 h-4 text-indigo-400" />
            <span>{item.label}</span>
          </a>
        );
      })}

      <div class="my-2 border-t border-white/10"></div>

      <a
        href={siteConfig.author.social.github || 'https://github.com'}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-semibold text-zinc-300 hover:text-white hover:bg-white/10 transition-all"
      >
        <Github class="w-4 h-4 text-zinc-400" />
        <span>GitHub Profile</span>
      </a>

      <a
        href={url('/rss.xml')}
        class="mobile-nav-link flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-semibold text-amber-400 hover:bg-amber-500/10 transition-all"
      >
        <Rss class="w-4 h-4" />
        <span>RSS Feed</span>
      </a>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!btn || !menu) return;

    function toggleMenu(show?: boolean) {
      const isCurrentlyHidden = menu?.classList.contains('hidden');
      const shouldShow = show !== undefined ? show : isCurrentlyHidden;

      if (shouldShow) {
        menu?.classList.remove('hidden');
        openIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        menu?.classList.add('hidden');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
