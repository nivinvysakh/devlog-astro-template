---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/ui/TableOfContents.astro';
import TagBadge from '../components/ui/TagBadge.astro';
import siteConfig from '../config/site';
import { Calendar, Clock, User, Share2, ArrowLeft, ArrowRight, Sparkles, Github, Twitter, Linkedin, Mail } from 'lucide-astro';

interface Props {
  post: any;
  headings: any[];
  readingTime?: string;
  prevPost?: any;
  nextPost?: any;
}

const { post, headings = [], readingTime, prevPost, nextPost } = Astro.props;
const data = post.data;

// Single author from centralized site config
const authorName = siteConfig.author.name;
const authorRole = siteConfig.author.role;
const authorAvatar = siteConfig.author.avatar;
const authorBio = siteConfig.author.bio;
const authorSocial = siteConfig.author.social;
const ui = siteConfig.ui || {
  shareTitle: 'Share This Post',
  shareDescription: 'Found this post helpful? Share it with your developer friends.',
  shareCopiedMessage: 'Post link copied to clipboard!',
  authorCardTitle: 'About the Author',
  writtenByText: 'Written by',
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.heroImage}
  article={true}
>
  <!-- Reading Progress Bar -->
  <div
    id="reading-progress-bar"
    class="fixed top-0 left-0 h-1 bg-gradient-to-r from-cyan-400 via-indigo-500 to-purple-500 z-50 transition-all duration-75 shadow-sm shadow-indigo-500/50"
    style="width: 0%;"
  ></div>

  <!-- Breadcrumb / Back Link -->
  <nav class="mb-6 flex items-center justify-between">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-zinc-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>All Articles</span>
    </a>

    <div class="flex items-center gap-2">
      <span class="bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 text-xs px-2.5 py-0.5 rounded-full border border-indigo-500/20 dark:border-indigo-400/25 font-semibold">
        {data.category}
      </span>
    </div>
  </nav>

  <!-- Article Header Banner -->
  <header class="p-6 sm:p-10 lg:p-12 liquid-glass rounded-3xl shadow-xl mb-8 relative overflow-hidden">
    <!-- Optional Hero Image on Top of Blog Post -->
    {data.heroImage && (
      <div class="mb-8 -mx-2 sm:-mx-4 -mt-2 sm:-mt-4 rounded-2xl overflow-hidden border border-white/20 dark:border-white/10 shadow-lg relative group">
        <img
          src={data.heroImage}
          alt={data.heroImageAlt || data.title}
          class="w-full h-60 sm:h-80 md:h-[380px] object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.02]"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-slate-950/10 to-transparent pointer-events-none"></div>
      </div>
    )}

    <!-- Top Tags & Meta -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/15 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20">
          {data.category}
        </span>
      </div>

      <div class="flex items-center gap-4 text-xs font-medium text-zinc-500 dark:text-zinc-400">
        <span class="flex items-center gap-1.5">
          <Calendar class="w-3.5 h-3.5 text-zinc-400" />
          {new Date(data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </span>
        {readingTime && (
          <span class="flex items-center gap-1.5 text-indigo-600 dark:text-indigo-400 font-medium">
            <Clock class="w-3.5 h-3.5" />
            {readingTime}
          </span>
        )}
      </div>
    </div>

    <!-- Main Title -->
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-50 tracking-tight leading-tight mb-5">
      {data.title}
    </h1>

    <!-- Description / Hook -->
    <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 font-normal leading-relaxed max-w-3xl mb-8">
      {data.description}
    </p>

    <!-- Meta bottom row -->
    <div class="pt-6 border-t border-white/20 dark:border-white/10 flex flex-wrap items-center justify-between gap-4">
      <!-- Author info with photo -->
      <div class="flex items-center gap-3">
        {authorAvatar && (authorAvatar.startsWith('/') || authorAvatar.startsWith('http')) ? (
          <img
            src={authorAvatar}
            alt={authorName}
            class="w-11 h-11 rounded-full object-cover border border-white/25 dark:border-white/10 shadow-md ring-2 ring-indigo-500/20"
          />
        ) : (
          <div class="w-11 h-11 rounded-full liquid-pill flex items-center justify-center font-bold text-sm text-indigo-600 dark:text-indigo-300 shadow-sm">
            {authorAvatar || '⚡'}
          </div>
        )}
        <div>
          <div class="font-bold text-sm text-zinc-900 dark:text-zinc-100">{authorName}</div>
          <div class="text-[11px] text-zinc-400">{authorRole}</div>
        </div>
      </div>

      <!-- Tag list -->
      <div class="flex flex-wrap gap-1.5">
        {data.tags?.map((tag: string) => (
          <TagBadge tag={tag} size="sm" />
        ))}
      </div>
    </div>
  </header>

  <!-- Main Content Layout Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left: Article Body (8 cols) -->
    <article data-pagefind-body class="lg:col-span-8 liquid-glass p-6 sm:p-10 rounded-3xl shadow-xl overflow-hidden">
      <div class="prose prose-zinc dark:prose-invert max-w-none 
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-zinc-900 dark:prose-headings:text-zinc-100
        prose-h2:border-b prose-h2:border-white/15 dark:prose-h2:border-white/10 prose-h2:pb-3 prose-h2:mt-10 prose-h2:mb-4
        prose-h3:text-zinc-900 dark:prose-h3:text-zinc-100 prose-h3:mt-8 prose-h3:mb-3
        prose-p:leading-relaxed prose-p:text-zinc-700 dark:prose-p:text-zinc-300
        prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-a:font-semibold prose-a:underline underline-offset-4 hover:prose-a:text-indigo-500
        prose-strong:font-bold prose-strong:text-zinc-900 dark:prose-strong:text-zinc-100
        prose-code:font-mono prose-code:text-indigo-600 dark:prose-code:text-indigo-400 prose-code:bg-indigo-500/10 dark:prose-code:bg-indigo-400/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-lg prose-code:border prose-code:border-indigo-500/15
        prose-blockquote:border-l-2 prose-blockquote:border-indigo-500 prose-blockquote:bg-white/40 dark:prose-blockquote:bg-white/5 prose-blockquote:py-2.5 prose-blockquote:px-5 prose-blockquote:rounded-r-2xl prose-blockquote:italic
      ">
        <slot />
      </div>

      <!-- Bottom Author Bio Card -->
      <div class="mt-10 p-6 sm:p-8 liquid-glass-card rounded-3xl border border-white/20 dark:border-white/10 shadow-lg">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
          {authorAvatar && (authorAvatar.startsWith('/') || authorAvatar.startsWith('http')) ? (
            <img
              src={authorAvatar}
              alt={authorName}
              class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl object-cover border border-white/30 dark:border-white/10 shadow-lg ring-2 ring-indigo-500/25 shrink-0"
            />
          ) : (
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl liquid-pill flex items-center justify-center text-3xl shadow-lg shrink-0">
              {authorAvatar || '⚡'}
            </div>
          )}

          <div class="flex-1">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border border-indigo-500/20 mb-1.5">
              {ui.writtenByText || 'Written by'}
            </div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">{authorName}</h3>
            <div class="text-xs text-indigo-600 dark:text-indigo-400 font-medium mb-2">{authorRole}</div>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
              {authorBio}
            </p>

            {authorSocial && (
              <div class="flex items-center gap-2">
                {authorSocial.github && (
                  <a href={authorSocial.github} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full liquid-pill hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors" title="GitHub">
                    <Github class="w-3.5 h-3.5" />
                  </a>
                )}
                {authorSocial.twitter && (
                  <a href={authorSocial.twitter} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full liquid-pill hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors" title="Twitter / X">
                    <Twitter class="w-3.5 h-3.5" />
                  </a>
                )}
                {authorSocial.linkedin && (
                  <a href={authorSocial.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full liquid-pill hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors" title="LinkedIn">
                    <Linkedin class="w-3.5 h-3.5" />
                  </a>
                )}
                {authorSocial.email && (
                  <a href={`mailto:${authorSocial.email}`} class="p-2 rounded-full liquid-pill hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors" title="Email">
                    <Mail class="w-3.5 h-3.5" />
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Chapter Navigation Links -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8 pt-8 border-t border-white/20 dark:border-white/10">
        {prevPost ? (
          <a
            href={`/blog/${prevPost.id.replace(/\.(md|mdx)$/, '')}`}
            class="p-4 rounded-2xl liquid-glass-card shadow-xs flex flex-col justify-between transition-all"
          >
            <span class="text-xs text-indigo-600 dark:text-indigo-400 font-semibold flex items-center gap-1 uppercase">
              <ArrowLeft class="w-3.5 h-3.5" /> Previous Article
            </span>
            <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 line-clamp-1 mt-1">
              {prevPost.data.title}
            </span>
          </a>
        ) : (
          <div class="p-4 rounded-2xl border border-dashed border-white/20 dark:border-white/10 text-zinc-400 font-mono text-xs flex items-center">
            // Earliest Post
          </div>
        )}

        {nextPost ? (
          <a
            href={`/blog/${nextPost.id.replace(/\.(md|mdx)$/, '')}`}
            class="p-4 rounded-2xl liquid-glass-card shadow-xs flex flex-col justify-between text-right transition-all"
          >
            <span class="text-xs text-indigo-600 dark:text-indigo-400 font-semibold flex items-center justify-end gap-1 uppercase">
              Next Post <ArrowRight class="w-3.5 h-3.5" />
            </span>
            <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 line-clamp-1 mt-1">
              {nextPost.data.title}
            </span>
          </a>
        ) : (
          <div class="p-4 rounded-2xl border border-dashed border-white/20 dark:border-white/10 text-zinc-400 font-mono text-xs flex items-center justify-end">
            // Latest Post
          </div>
        )}
      </div>
    </article>

    <!-- Right: Sidebar (4 cols) -->
    <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto pr-1">
      <!-- Table of Contents -->
      <TableOfContents headings={headings} />

      <!-- Author Profile Card with Photo -->
      <div class="p-6 liquid-glass rounded-3xl shadow-lg overflow-hidden">
        <div class="flex items-center justify-between border-b border-white/20 dark:border-white/10 pb-3 mb-4">
          <span class="text-xs font-bold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider">{ui.authorCardTitle || 'About the Author'}</span>
        </div>

        <div class="flex items-start gap-3.5">
          {authorAvatar && (authorAvatar.startsWith('/') || authorAvatar.startsWith('http')) ? (
            <img
              src={authorAvatar}
              alt={authorName}
              class="w-12 h-12 rounded-2xl object-cover border border-white/25 dark:border-white/10 shadow-md ring-2 ring-indigo-500/20 shrink-0"
            />
          ) : (
            <div class="w-11 h-11 rounded-full liquid-pill flex items-center justify-center text-lg shadow-sm shrink-0">
              {authorAvatar || '⚡'}
            </div>
          )}
          <div>
            <div class="font-bold text-sm text-zinc-900 dark:text-zinc-50">{authorName}</div>
            <div class="text-[11px] text-indigo-600 dark:text-indigo-400 font-medium">{authorRole}</div>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1.5 leading-relaxed">
              {authorBio}
            </p>

            {authorSocial && (
              <div class="flex items-center gap-1.5 mt-3 pt-2.5 border-t border-white/10">
                {authorSocial.github && (
                  <a href={authorSocial.github} target="_blank" rel="noopener noreferrer" class="p-1 text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors" title="GitHub">
                    <Github class="w-3.5 h-3.5" />
                  </a>
                )}
                {authorSocial.twitter && (
                  <a href={authorSocial.twitter} target="_blank" rel="noopener noreferrer" class="p-1 text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors" title="Twitter / X">
                    <Twitter class="w-3.5 h-3.5" />
                  </a>
                )}
                {authorSocial.linkedin && (
                  <a href={authorSocial.linkedin} target="_blank" rel="noopener noreferrer" class="p-1 text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors" title="LinkedIn">
                    <Linkedin class="w-3.5 h-3.5" />
                  </a>
                )}
                {authorSocial.email && (
                  <a href={`mailto:${authorSocial.email}`} class="p-1 text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors" title="Email">
                    <Mail class="w-3.5 h-3.5" />
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Share Widget -->
      <div class="p-6 liquid-glass rounded-3xl shadow-lg overflow-hidden">
        <div class="text-xs uppercase tracking-wider font-bold text-zinc-900 dark:text-zinc-100 mb-1.5">
          {ui.shareTitle || 'Share This Post'}
        </div>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-4 leading-relaxed">
          {ui.shareDescription || 'Found this post helpful? Share it with your developer friends.'}
        </p>
        <button
          onclick={`navigator.clipboard.writeText(window.location.href); alert(${JSON.stringify(ui.shareCopiedMessage || 'Post link copied to clipboard!')});`}
          class="w-full py-2.5 rounded-full liquid-pill hover:text-indigo-600 dark:hover:text-indigo-300 text-xs font-semibold cursor-pointer flex items-center justify-center gap-2 shadow-xs transition-all"
        >
          <Share2 class="w-3.5 h-3.5" />
          <span>Copy Post Link</span>
        </button>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  function setupReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    });
  }

  setupReadingProgress();
  document.addEventListener('astro:after-swap', setupReadingProgress);
</script>
