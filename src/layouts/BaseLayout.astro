---
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import siteConfig from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.defaultOgImage || '/images/og-default.png',
  article = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteConfig.url);
const faviconUrl = siteConfig.favicon || '/favicon.svg';
const faviconType =
  faviconUrl.endsWith('.svg') || faviconUrl.startsWith('data:image/svg')
    ? 'image/svg+xml'
    : faviconUrl.endsWith('.png')
    ? 'image/png'
    : 'image/x-icon';
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#060810" />
    <link rel="icon" type={faviconType} href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS Feed`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
  </head>
  <body class="relative min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white overflow-x-hidden">
    
    <!-- Ambient Fluid Lighting Background Mesh (Zero tile seams & high performance) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <!-- Top Right Indigo/Cyan Mesh -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_85%_-10%,rgba(56,189,248,0.18),rgba(99,102,241,0.14)_35%,transparent_70%)] dark:bg-[radial-gradient(ellipse_80%_60%_at_85%_-10%,rgba(56,189,248,0.12),rgba(99,102,241,0.16)_40%,transparent_70%)]"></div>
      
      <!-- Top Left Violet/Rose Mesh -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_10%_25%,rgba(168,85,247,0.14),rgba(244,63,94,0.06)_40%,transparent_70%)] dark:bg-[radial-gradient(ellipse_60%_50%_at_10%_25%,rgba(129,140,248,0.12),rgba(147,51,234,0.08)_40%,transparent_70%)]"></div>
      
      <!-- Bottom Center Blue/Cyan Mesh -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_80%,rgba(14,165,233,0.1),rgba(99,102,241,0.08)_40%,transparent_70%)] dark:bg-[radial-gradient(ellipse_70%_50%_at_50%_80%,rgba(30,58,138,0.18),transparent_70%)]"></div>
    </div>

    <!-- Main Content Layer -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <Header />
      <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
